{
  "extends": "@repo/typescript-config/native.json",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": [
    "node_modules",
    "**/*.test.ts",
    "**/*.test.tsx",
    "test",
    "vitest.config.mts",
    "vitest.setup.ts",
    "vitest.polyfills.ts"
  ]
}

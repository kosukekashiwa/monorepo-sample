{
  "extends": "@repo/typescript-config/web.json",
  "compilerOptions": {
    "strict": true,
    "rootDirs": [".", "./.react-router/types"],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "**/*",
    "**/.server/**/*",
    "**/.client/**/*",
    ".react-router/types/**/*"
  ],
  "exclude": ["node_modules"]
}
